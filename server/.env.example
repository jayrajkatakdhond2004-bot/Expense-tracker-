# Server
NODE_ENV=development
# 5050 rather than 5000: macOS uses port 5000 for AirPlay Receiver.
PORT=5050

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/expense-tracker

# JWT: use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins
CLIENT_URL=http://localhost:5173

# Defaults to true when NODE_ENV=production. Set to false only for local HTTP.
# COOKIE_SECURE=false

# Requests per 15 minutes per IP
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
